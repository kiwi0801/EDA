<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns="urn:semi-org:xsd.E134-1.V1105.DCM" xmlns:eca="urn:semi-org:xsd.E132-1.V0305.auth" xmlns:ccs="urn:semi-org:xsd.CommonComponents.V0305.ccs" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:dcm="urn:semi-org:xsd.E134-1.V1105.DCM" targetNamespace="urn:semi-org:xsd.E134-1.V1105.DCM" elementFormDefault="qualified">
